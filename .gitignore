# Default ignored files
/shelf/
/.idea/workspace.xml
# Ignored default folder with query files
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
# Editor-based HTTP Client requests
/httpRequests/
__pycache__/
*.pyc
.idea/

# Secrets — never commit (use .env.example as the template)
# The pattern is deliberately broad: a backup like .env.stg-backup-2026-09-07 was sitting
# untracked and would have been committed by any `git add -A`.
.env
.env.*
!.env.example